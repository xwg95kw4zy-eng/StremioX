diff --git a/app/Sources/CastManager.swift b/app/Sources/CastManager.swift
new file mode 100644
index 0000000..d870190
--- /dev/null
+++ b/app/Sources/CastManager.swift
@@ -0,0 +1,170 @@
+import Foundation
+import GoogleCast
+
+/// Sends the current stream to a Chromecast using Google's Cast SDK and the Default Media Receiver.
+///
+/// The Chromecast can't reach the phone's own embedded server (127.0.0.1) and an old Chromecast
+/// can only decode H.264/AAC, so instead of handing it the raw stream we hand it an HLS URL on a
+/// Stremio streaming server elsewhere on the LAN (the user's PC). That server's `hlsv2` endpoint
+/// fetches the original stream and transcodes whatever the Chromecast can't play (on the PC's GPU
+/// when hardware transcoding is enabled there).
+final class CastManager: NSObject, GCKSessionManagerListener {
+    static let shared = CastManager()
+
+    /// UserDefaults key for the LAN streaming server the Chromecast should pull from.
+    static let serverKey = "stremiox.castServer"
+    static let defaultServer = "http://10.10.10.170:11470"
+
+    /// UserDefaults key: re-encode BOTH video and audio when casting (default on).
+    /// When only the audio is converted and the video is copied, the two tracks carry slightly
+    /// different timestamps and the Chromecast's audio drifts further out of sync over time.
+    /// A full conversion rebuilds both with matching timing (and also catches 10-bit H.264,
+    /// which looks compatible but old Chromecasts can't decode).
+    static let forceTranscodeKey = "stremiox.castForceTranscode"
+
+    static var forceTranscode: Bool {
+        get { UserDefaults.standard.object(forKey: forceTranscodeKey) as? Bool ?? true }
+        set { UserDefaults.standard.set(newValue, forKey: forceTranscodeKey) }
+    }
+
+    private var pendingMedia: GCKMediaInformation?
+    private var pendingPosition: TimeInterval = 0
+
+    /// Call once at launch, before any Cast UI is used.
+    static func setUp() {
+        let criteria = GCKDiscoveryCriteria(applicationID: kGCKDefaultMediaReceiverApplicationID)
+        let options = GCKCastOptions(discoveryCriteria: criteria)
+        options.physicalVolumeButtonsWillControlDeviceVolume = true
+        GCKCastContext.setSharedInstanceWith(options)
+        GCKCastContext.sharedInstance().useDefaultExpandedMediaControls = true
+        GCKCastContext.sharedInstance().sessionManager.add(shared)
+        GCKCastContext.sharedInstance().discoveryManager.startDiscovery()
+    }
+
+    static var serverBase: String {
+        let saved = UserDefaults.standard.string(forKey: serverKey)?
+            .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+        let base = saved.isEmpty ? defaultServer : saved
+        return base.hasSuffix("/") ? String(base.dropLast()) : base
+    }
+
+    /// Cast `stream`. If no Chromecast is connected yet, shows the device picker and casts as
+    /// soon as a session starts.
+    func cast(stream: URL, title: String, position: TimeInterval) {
+        guard let castURL = Self.castableURL(for: stream) else {
+            NSLog("StremioX cast: could not build a castable URL for \(stream.absoluteString)")
+            return
+        }
+        NSLog("StremioX cast: \(castURL.absoluteString)")
+
+        let builder = GCKMediaInformationBuilder(contentURL: castURL)
+        builder.streamType = .buffered
+        builder.contentType = "application/x-mpegURL"
+        // Audio comes muxed inside the video segments (muxAudio=1 below), the plain MPEG-TS
+        // HLS layout every Chromecast supports, so no segment-format hints are needed.
+        let metadata = GCKMediaMetadata(metadataType: .movie)
+        metadata.setString(title.isEmpty ? "StremioX" : title, forKey: kGCKMetadataKeyTitle)
+        builder.metadata = metadata
+        let media = builder.build()
+
+        let context = GCKCastContext.sharedInstance()
+        if let session = context.sessionManager.currentCastSession {
+            load(media, position: position, on: session)
+        } else {
+            pendingMedia = media
+            pendingPosition = position
+            context.presentCastDialog()
+        }
+    }
+
+    private func load(_ media: GCKMediaInformation, position: TimeInterval, on session: GCKCastSession) {
+        let options = GCKMediaLoadOptions()
+        options.autoplay = true
+        options.playPosition = position
+        session.remoteMediaClient?.loadMedia(media, with: options)
+        GCKCastContext.sharedInstance().presentDefaultExpandedMediaControls()
+    }
+
+    /// End the cast session and stop the TV. Returns where the TV had got to, if known, so the
+    /// phone can carry on from the same point.
+    @discardableResult
+    func stopCasting() -> TimeInterval? {
+        pendingMedia = nil
+        let sessionManager = GCKCastContext.sharedInstance().sessionManager
+        let position = sessionManager.currentCastSession?.remoteMediaClient?.approximateStreamPosition()
+        sessionManager.endSessionAndStopCasting(true)
+        if let position, position > 0 { return position }
+        return nil
+    }
+
+    // MARK: - GCKSessionManagerListener
+
+    func sessionManager(_ sessionManager: GCKSessionManager, didStart session: GCKCastSession) {
+        guard let media = pendingMedia else { return }
+        pendingMedia = nil
+        load(media, position: pendingPosition, on: session)
+    }
+
+    func sessionManager(_ sessionManager: GCKSessionManager, didFailToStart session: GCKCastSession,
+                        withError error: Error) {
+        NSLog("StremioX cast: session failed to start: \(error.localizedDescription)")
+        pendingMedia = nil
+    }
+
+    // MARK: - URL building
+
+    /// Wraps the stream in the LAN server's HLS transcoding endpoint, asking for only the codecs
+    /// an older Chromecast handles (H.264 video, AAC/MP3 stereo audio).
+    static func castableURL(for stream: URL) -> URL? {
+        guard let server = URLComponents(string: serverBase), server.host != nil else { return nil }
+        var source = stream
+
+        // Streams on the phone's own embedded server (torrents) are invisible to the Chromecast,
+        // so point them at the same path on the LAN server and ask it to start that torrent.
+        if let host = stream.host, host == "127.0.0.1" || host == "localhost",
+           var comps = URLComponents(url: stream, resolvingAgainstBaseURL: false) {
+            comps.scheme = server.scheme
+            comps.host = server.host
+            comps.port = server.port
+            guard let rewritten = comps.url else { return nil }
+            source = rewritten
+            let parts = stream.pathComponents.filter { $0 != "/" }
+            if parts.count >= 2, parts[0].count == 40 {
+                createTorrent(infoHash: parts[0].lowercased())
+            }
+        }
+
+        func enc(_ s: String) -> String {
+            s.addingPercentEncoding(withAllowedCharacters: .alphanumerics) ?? s
+        }
+        var params = [
+            "mediaURL=\(enc(source.absoluteString))",
+            "videoCodecs=h264",
+            "audioCodecs=aac",
+            "audioCodecs=mp3",
+            "maxAudioChannels=2",
+            // Ask for audio inside the video segments. A separate audio rendition was fetched by
+            // older Chromecasts but played silently, and one pass for both keeps them in sync.
+            // Servers that don't know the flag ignore it.
+            "muxAudio=1",
+        ]
+        // Same flag Stremio's own player sends (stremio-video withStreamingServer.js).
+        if forceTranscode { params.insert("forceTranscoding=1", at: 1) }
+        let query = params.joined(separator: "&")
+        let id = UUID().uuidString.lowercased()
+        return URL(string: "\(serverBase)/hlsv2/\(id)/master.m3u8?\(query)")
+    }
+
+    private static func createTorrent(infoHash: String) {
+        guard let url = URL(string: "\(serverBase)/\(infoHash)/create"),
+              let body = try? JSONSerialization.data(withJSONObject: [
+                  "torrent": ["infoHash": infoHash],
+                  "peerSearch": ["sources": ["dht:\(infoHash)"], "min": 40, "max": 150],
+              ]) else { return }
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.httpBody = body
+        URLSession.shared.dataTask(with: request).resume()
+    }
+}
